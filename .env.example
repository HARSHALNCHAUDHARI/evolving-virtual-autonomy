# ==================================
# EVA — Environment Configuration
# ==================================
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# Environment: development | testing | production
EVA_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
EVA_LOG_LEVEL=INFO

# Debug mode (enables verbose output)
EVA_DEBUG=false

# PostgreSQL Persistent Memory (Milestone 1E.3)
# EVA_POSTGRES_DSN=postgresql://eva:eva@localhost:5432/eva
# EVA_POSTGRES_MIN_POOL_SIZE=2
# EVA_POSTGRES_MAX_POOL_SIZE=10
# EVA_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/eva

# Redis Working Memory (Milestone 1E.4)
# EVA_REDIS_URL=redis://localhost:6379/0
# EVA_REDIS_MAX_CONNECTIONS=10
# EVA_REDIS_SOCKET_TIMEOUT=5.0
# EVA_REDIS_KEY_PREFIX=eva:working
# EVA_REDIS_DEFAULT_TTL_SECONDS=3600

# Model provider: mock | openai | gemini | anthropic | local
EVA_MODEL_PROVIDER=mock
EVA_DEFAULT_PROVIDER=mock

# Model name (provider-specific)
EVA_MODEL_NAME=mock-v1
EVA_DEFAULT_MODEL=mock-v1

# Gemini Provider (Milestone 1D.2)
# EVA_GEMINI_API_KEY=
EVA_GEMINI_MODEL=gemini-1.5-flash
EVA_GEMINI_TIMEOUT=30.0

# API keys (never commit real values)
# EVA_OPENAI_API_KEY=
# EVA_ANTHROPIC_API_KEY=
# EVA_GOOGLE_API_KEY=
